# --- Database ---
DATABASE_URL="postgresql://neoncrate:neoncrate@localhost:5432/neoncrate"

# --- Redis (rate limiting, caching, distributed locks) ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js / @sidebase/nuxt-auth ---
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_ORIGIN="http://localhost:3000/api/auth"

# OAuth providers (fill in what you enable)
MICROSOFT_ENTRA_CLIENT_ID=""
MICROSOFT_ENTRA_CLIENT_SECRET=""
MICROSOFT_ENTRA_TENANT_ID=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Magic link email delivery (any SMTP or transactional provider)
EMAIL_SERVER=""
EMAIL_FROM="NeonCrate <no-reply@example.com>"

# Dev-only credentials login (NODE_ENV !== production). Any seeded user's
# email works with this one shared password — see README "E2E-tester" for
# how to generate the hash.
DEV_PASSWORD_HASH=""

# --- Economy (safe defaults — see prisma/seed.ts) ---
STARTING_BALANCE=10000
DAILY_BONUS_AMOUNT=250
MARKET_FEE_BPS=700
